.bottom-container { background: transparent !important; }

:is(.prompt-box-container,.mc-composer) {

  position: relative !important;

  background: linear-gradient(135deg,#fcf8fdf5,#eaddf0f0) !important;

  border: 1px solid #ac94bb !important;

  border-radius: 25px !important;

  box-shadow: inset 0 0 0 4px #ffffff9c,inset 0 0 0 5px #d3bedb9c,

