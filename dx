(function() {

  'use strict';


  // =========================================================================

  // PHẦN 1: KHUNG CHỨA CODE CSS (DÁN CODE STYLUS TỪ LAPTOP VÀO GIỮA 2 DẤU ` `)

  // =========================================================================

  const myLaptopCSS = String.raw`@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,600;1,700&family=Dancing+Script:wght@700&family=Playfair+Display:ital,wght@1,600;1,700&family=Quicksand:wght@600;700&display=swap');

/*

 * MOONMILK CAT — Pastel Noir Twinkle, v2.4

 * Stylus: URLs on the domain -> aistudio.google.com

 * Use AI Studio Light mode. Disable other AI Studio themes.

 * Companion script adds precise cat/bow placements and keeps click controls.

 * Supplied Pinterest image + original animated GIFs are embedded below.

 */

:root {

  --dr-bg: #e9e5ec;

  --dr-panel: #faf7fbdc;

  --dr-panel-high: #f4eff7;

  --dr-field: #ffffffd9;

  --dr-ink: #47424d;

  --dr-muted: #79717f;

  --dr-rose: #a57894;

  --dr-gold: #8d809c;

  --dr-lilac: #887393;

  --dr-border: #c1b1c9;

  --dr-hairline: #ded3e3;

  --dr-ui-font: "Google Sans", "Segoe UI", Arial, sans-serif;

  --dr-story-font: "Google Sans", "Segoe UI", Arial, sans-serif;

  --dr-chat-size: 15.5px;

  --mc-input-size: 14px;

  --mc-user-bg: linear-gradient(135deg, #e4cfe4f2, #d9d2e8f2 68%, #e9d2dff2);

  --mc-char-bg: linear-gradient(135deg, #fffdfef2, #f4f0f8ef 75%, #faedf4f0);

  --mc-background: url("data:image/jpeg;base64,");

  --mc-icon: url("data:image/gif;base64,");

  --mc-bow: url("data:image/gif;base64,");

  --mc-icon-still: url("data:image/png;base64,");

  --mc-bow-still: url("data:image/png;base64,");

  --mc-ears: url("data:image/svg+xml;base64,");

}

:root, body, body.dark-theme, body.light-theme {

  --color-v3-primary: #936c89 !important;

  --color-v3-on-primary: #ffffff !important;

  --color-v3-primary-container: #e9d8e8 !important;

  --color-v3-on-primary-container: #574358 !important;

  --color-v3-secondary: #8d7c9b !important;

  --color-v3-on-secondary: #ffffff !important;

  --color-v3-secondary-container: #e8e0ef !important;

  --color-v3-on-secondary-container: #51475d !important;

  --color-v3-tertiary: #a17891 !important;

  --color-v3-background: #f2edf4 !important;

  --color-v3-on-background: var(--dr-ink) !important;

  --color-v3-surface: #faf7fb !important;

  --color-v3-surface-dim: #eae3ef !important;

  --color-v3-surface-bright: #ffffff !important;

  --color-v3-surface-container-lowest: #ffffff !important;

  --color-v3-surface-container-low: #faf6fc !important;

  --color-v3-surface-container: #f3edf6 !important;

  --color-v3-surface-container-high: #ede4f1 !important;

  --color-v3-surface-container-highest: #e5d9e9 !important;

  --color-v3-surface-variant: #ede5f1 !important;

  --color-v3-surface-tint: #ad86a4 !important;

  --color-v3-on-surface: var(--dr-ink) !important;

  --color-v3-on-surface-variant: var(--dr-muted) !important;

  --color-v3-outline: #b19dbb !important;

  --color-v3-outline-var: var(--dr-hairline) !important;

  --color-v3-outline-variant: var(--dr-hairline) !important;

  --color-v3-inverse-surface: #48404f !important;

  --color-v3-inverse-on-surface: #fcf7fc !important;

  --color-v3-error: #ab5369 !important;

  --mdc-theme-primary: #936c89 !important;

  --mdc-theme-surface: #faf7fb !important;

  --mdc-theme-on-surface: var(--dr-ink) !important;

  --mat-app-background-color: #f3eef6 !important;

  --mat-app-text-color: var(--dr-ink) !important;

  --mat-dialog-container-color: #faf7fb !important;

  --mat-dialog-supporting-text-color: var(--dr-ink) !important;

  --mat-menu-container-color: #f7f1fa !important;

  --mat-menu-item-label-text-color: var(--dr-ink) !important;

  --mat-select-panel-background-color: #f7f1fa !important;

  --mat-select-enabled-trigger-text-color: var(--dr-ink) !important;

  --mat-option-label-text-color: var(--dr-ink) !important;

  --mat-option-selected-state-label-text-color: #76556f !important;

  --mat-option-selected-state-layer-color: #e9d8e8 !important;

  --mdc-dialog-container-color: #faf7fb !important;

  --mdc-dialog-subhead-color: var(--dr-ink) !important;

  --mdc-dialog-supporting-text-color: var(--dr-muted) !important;

  --mdc-outlined-text-field-input-text-color: var(--dr-ink) !important;

  --mdc-outlined-text-field-label-text-color: var(--dr-muted) !important;

  --mdc-outlined-text-field-outline-color: var(--dr-border) !important;

  --mdc-filled-text-field-container-color: #fcf9fd !important;

  --mdc-filled-text-field-input-text-color: var(--dr-ink) !important;

  --mdc-filled-text-field-label-text-color: var(--dr-muted) !important;

}

html, body {

  color-scheme: light !important;

  color: var(--dr-ink) !important;

  font-family: var(--dr-ui-font) !important;

  font-size: 14px !important;

  font-weight: 400 !important;

  background-color: #29232e !important;

}

body {

  isolation: isolate;

  background-image: linear-gradient(#eee5f226, #f1e2ee33), var(--mc-background) !important;

  background-size: cover !important;

  background-position: center !important;

  background-attachment: fixed !important;

}

body::before {

  content: "";

  position: fixed;

  inset: 0;

  z-index: 0;

  pointer-events: none;

  background-image: radial-gradient(circle at 27px 47px, #ffffff 0 1px, transparent 1.9px),

    radial-gradient(circle at 170px 190px, #fff0fa 0 .8px, transparent 1.7px);

  background-size: 280px 250px, 370px 330px;

  opacity: .25;

  animation: mc-twinkle 6s ease-in-out infinite alternate;

}

:is(ms-app, app-root) { position: relative; z-index: 1; }

:is(ms-app,app-root,.banner-and-app-container,.makersuite-layout,.layout-wrapper,

.layout-main,.main-content-container,.main-content,main,.chat-container,

.chat-view-container,section.chunk-editor-main,.chunk-editor-main,

ms-autoscroll-container,mat-sidenav-container,mat-sidenav-content,

.mat-drawer-container,.mat-drawer-content,.history-container,.history-page) {

  background: transparent !important;

  color: var(--dr-ink) !important;

}

/* Pearl glass frames, scalloped-looking double outlines and fine dark details. */

:is(ms-navbar,ms-omnibar,ms-playground-toolbar,.page-header,mat-toolbar,

mat-sidenav,.mat-drawer,.sidebar,.side-nav,.settings-panel,.run-settings-panel,

.console-right-panel,.right-panel,.editor-panel,ms-run-settings,ms-prompt-run-settings,

.mc-side-left,.mc-side-right) {

  background: linear-gradient(150deg,#fffafde8,#ede8f3e8) !important;

  color: var(--dr-ink) !important;

  border-color: #b9a9c1 !important;

  backdrop-filter: blur(14px);

}

:is(mat-sidenav,.mat-drawer,.mc-side-left,.mc-side-right,.settings-panel,.run-settings-panel) {

  border: 1px solid #c5b6cd !important;

  box-shadow: inset 0 0 0 4px #fffbfd9c, inset 0 0 0 5px #d4c6dba1,0 5px 24px #21182e26 !important;

}

:is(nav,ms-navbar,mat-sidenav,.mc-side-left) :is(a,button,.nav-item,.mdc-list-item) {

  color: #5b515f !important;

  border-radius: 15px !important;

  font-size: 13px !important;

  font-weight: 400 !important;

}

:is(nav,ms-navbar,mat-sidenav,.mc-side-left) :is(a,button,.nav-item,.mdc-list-item):hover,

:is(nav,ms-navbar,mat-sidenav,.mc-side-left) :is(.active,.selected,[aria-current="page"]) {

  background: linear-gradient(110deg,#dfd1e8,#f0dce9) !important;

  color: #514252 !important;

  box-shadow: inset 0 0 0 1px #bda8c6,0 2px 8px #93788e12 !important;

}

:is(h1,h2,h3,h4,h5,h6,p,label,input,textarea,select,button,

.mdc-button__label,.mdc-list-item__primary-text,.mat-mdc-select-value,.mat-mdc-option,

.mat-mdc-tab,.mat-mdc-chip,.page-title,.dialog-title) {

  font-family: var(--dr-ui-font) !important;

  font-weight: 400 !important;

  letter-spacing: .03px !important;

}

:is(h1,h2,h3,h4,h5,h6,label,.mdc-button__label,.mdc-list-item__primary-text,

.mat-mdc-select-value,.mat-mdc-option,.mat-mdc-tab) { color: var(--dr-ink) !important; }

:is(h1,h2,.page-title,.dialog-title,.mat-mdc-dialog-title) {

  color: #66546b !important;

  font-size: 19px !important;

  font-weight: 500 !important;

  text-shadow: 0 1px #fff,0 0 14px #f1d0e9;

  animation: mc-letterglow 7s ease-in-out infinite alternate;

}

:is(h3,h4,h5) { font-size: 14px !important; font-weight: 500 !important; }

:is(.subtitle,.description,.secondary-text,.hint,.mat-mdc-form-field-hint,

.mat-mdc-dialog-content,.mat-mdc-card-subtitle) { color: var(--dr-muted) !important; }

a { color: #846b91 !important; }

a:hover { color: #a35c87 !important; }

:is(mat-icon,.material-icons,.material-symbols-outlined,.material-symbols-rounded) {

  color: #8a738e !important;

}

/* History has its own framed list and decorated search field. */

.mc-history-title {

  display: inline-block !important;

  padding: 8px 17px !important;

  background: #faf5fbe8 !important;

  border: 1px solid #c6b7cf !important;

  border-radius: 14px !important;

  box-shadow: 0 2px 9px #38213d12 !important;

}

:is(table,.mat-mdc-table,.mat-table,.history-list,.prompt-list) {

  background: #f9f5fce8 !important;

  color: var(--dr-ink) !important;

  border: 1px solid #b9a9c3 !important;

  border-radius: 19px !important;

  box-shadow: 0 0 0 3px #fff7,0 8px 30px #1d132f18 !important;

}

:is(th,td,.mat-mdc-header-cell,.mat-mdc-cell,.mat-header-cell,.mat-cell) {

  color: var(--dr-ink) !important;

  background: transparent !important;

  border-color: #d7c9de !important;

  font-size: 13px !important;

  font-weight: 400 !important;

}

:is(th,.mat-mdc-header-cell) { color: #8b6e92 !important; }

:is(tr,.mat-mdc-row,.history-item,.prompt-list-item,.file-row,[role="row"]):hover {

  background: linear-gradient(90deg,#e5d8eee0,#f3dfebe0) !important;

}

:is(.history-item,.prompt-list-item,.file-row) { color: var(--dr-ink) !important; border-color: var(--dr-hairline) !important; }

:is(.mc-history-search,.search-container,.search-box,.search-wrapper):has(input) {

  position: relative !important;

  border: 1px solid #a99bb4 !important;

  border-radius: 18px !important;

  background: linear-gradient(115deg,#fffbfe,#eee6f5) !important;

  box-shadow: 0 0 0 3px #ffffff70,0 3px 14px #87709321 !important;

}

.mc-history-search input { background: transparent !important; }

.mc-search-input {

  border: 1px solid #a99bb4 !important;

  border-radius: 18px !important;

  background-image: var(--mc-bow) !important;

  background-size: 24px 24px !important;

  background-position: right 8px center !important;

  background-repeat: no-repeat !important;

  padding-inline-end: 38px !important;

}

/* Individual cards, not just the outer model panel. */

:is(mat-card,.mat-mdc-card,.model-card,.model-item,.model-option,.settings-card,

.system-instructions-card,.run-settings-card,.model-selector-card,.model-list-item,

.model-info-card,.mc-model-card,.mc-system-card) {

  position: relative !important;

  background: linear-gradient(135deg,#fffcfeee,#eee8f6ef) !important;

  color: var(--dr-ink) !important;

  border: 1px solid #b6a3c1 !important;

  border-radius: 20px !important;

  box-shadow: inset 0 0 0 3px #ffffff7d,0 4px 12px #6e567c12 !important;

}

:is(.model-card,.model-item,.mc-model-card,.mc-system-card) {

  margin-block: 15px !important;

  padding: 30px 18px 17px !important;

}

:is(.model-card,.model-item,.mc-model-card):hover {

  border-color: #967aa7 !important;

  box-shadow: inset 0 0 0 3px #ffffff99,0 4px 18px #ab80a32a !important;

}

/* Popovers, model selection, system instruction editor and menus. */

:is(.mat-mdc-dialog-surface,.mdc-dialog__surface,.mat-dialog-container,

.mat-mdc-menu-panel,.mat-mdc-select-panel,.mat-autocomplete-panel,

.mat-mdc-autocomplete-panel,[role="dialog"],[role="listbox"],[role="menu"],

.mc-system-panel,.mc-model-panel) {

  color: var(--dr-ink) !important;

  background: linear-gradient(145deg,#fffafdf7,#eae3f2f7) !important;

  border: 1px solid #a994b6 !important;

  border-radius: 23px !important;

  box-shadow: inset 0 0 0 4px #ffffff94,inset 0 0 0 5px #d2c1dca1,

    0 22px 65px #1d152e42,0 0 0 4px #f1e9f14d !important;

  backdrop-filter: blur(16px);

}

.cdk-overlay-backdrop.cdk-overlay-backdrop-showing { background: #2e253e5e !important; backdrop-filter: blur(5px); }

:is(.cdk-overlay-pane,[role="dialog"],.mc-system-panel,.mc-model-panel,

.mc-side-right,.settings-panel,.run-settings-panel,.console-right-panel)

:is(.container,.content,.header,.footer,.section,.model-list,.models-container,.dialog-content,.panel-content) {

  color: var(--dr-ink) !important;

  background-color: transparent !important;

  border-color: var(--dr-hairline) !important;

}

:is(.mat-mdc-option,[role="option"],.mat-mdc-menu-item,[role="menuitem"]) {

  color: var(--dr-ink) !important;

  background: transparent !important;

}

:is(.mat-mdc-option,[role="option"],.mat-mdc-menu-item,[role="menuitem"]):hover,

:is(.mat-mdc-option,[role="option"])[aria-selected="true"] { background: #dfd0e797 !important; }

/* Inputs are fine and small; never inherit the large story font. */

:is(input:not([type="checkbox"]):not([type="radio"]):not([type="range"]),textarea,

select,[contenteditable="true"],.mat-mdc-text-field-wrapper,.mdc-text-field,.mat-mdc-select-trigger) {

  background-color: #fefbffd9 !important;

  color: var(--dr-ink) !important;

  caret-color: #a46d91 !important;

  border-color: #c0aecb !important;

  border-radius: 13px !important;

  font: 400 13px / 1.65 var(--dr-ui-font) !important;

}

:is(input,textarea)::placeholder { color: #9b8d9f !important; font-weight: 400 !important; opacity: 1 !important; }

:is(button,[role="button"],.mat-button-toggle,.mat-mdc-chip) { border-color: #c6b6cf !important; }

:is(button,[role="button"]):not(:disabled):hover { box-shadow: 0 0 12px #c695be30 !important; }

:is(button[aria-pressed="true"],button[aria-selected="true"],.mat-button-toggle-checked,

.mat-mdc-tab.mdc-tab--active,.mat-mdc-chip-selected) { background: #e7d8ed !important; color: #66506c !important; }

:is(hr,.mat-divider,.mat-mdc-divider) { border-color: var(--dr-hairline) !important; }

:is(button,a,input,textarea,select,[contenteditable="true"],[tabindex]):focus-visible {

  outline: 2px solid #a37daf !important;

  outline-offset: 3px !important;

}

input[type="range"],input[type="checkbox"],input[type="radio"] { accent-color: #a27fab !important; }

:is(.mdc-switch,.mat-mdc-slide-toggle) {

  --mdc-switch-selected-track-color: #b798bd !important;

  --mdc-switch-selected-handle-color: #fffaff !important;

  --mdc-switch-unselected-track-color: #cdc3d4 !important;

  --mdc-switch-unselected-handle-color: #fbf8fc !important;

}

/* Char = pearl; user = deeper lilac-rose. All outlines stay thin. */

:is(.chat-turn-container,:where(.turn:not(:has(.chat-turn-container)):not(.chat-turn-container .turn)),

.mc-user-turn,.mc-model-turn) {

  position: relative !important;

  background: var(--mc-char-bg) !important;

  border: 1px solid #bdaac8 !important;

  border-radius: 25px 25px 25px 9px !important;

  color: var(--dr-ink) !important;

  padding: 22px 27px !important;

  margin: 20px 10px !important;

  box-shadow: inset 0 0 0 4px #ffffff9c,inset 0 0 0 5px #dfd0e56b,

    0 5px 17px #17102021 !important;

  backdrop-filter: blur(10px);

}

:is(.chat-turn-container.user,:where(.turn.input:not(:has(.chat-turn-container)):not(.chat-turn-container .turn)),.mc-user-turn) {

  background: var(--mc-user-bg) !important;

  border-color: #a88ab6 !important;

  border-radius: 25px 25px 9px 25px !important;

  box-shadow: inset 0 0 0 4px #fff6,inset 0 0 0 5px #b69ac25e,0 6px 18px #17102021 !important;

}

:is(.turn-content,.response-container,.model-response) { background: transparent !important; }

:is(ms-cmark-node,.markdown,.markdown-body,.model-response,.chat-turn-container .text-chunk,

.turn.input .text-chunk,.mc-user-turn .text-chunk,.mc-model-turn .text-chunk) {

  color: var(--dr-ink) !important;

  font-family: var(--dr-story-font) !important;

  font-size: var(--dr-chat-size) !important;

  font-weight: 400 !important;

  letter-spacing: .04px !important;

  line-height: 1.9 !important;

  text-shadow: none !important;

}

:is(ms-cmark-node,.markdown,.markdown-body) :is(p,li,blockquote) {

  font-family: var(--dr-story-font) !important;

  font-size: inherit !important;

  font-weight: 400 !important;

  line-height: 1.9 !important;

  color: var(--dr-ink) !important;

}

:is(ms-cmark-node,.markdown,.markdown-body) p { margin: 0 0 1em !important; }

:is(.turn-header,.author-label) {

  color: #8f7c99 !important;

  background: transparent !important;

  font: 400 11.5px / 1.6 var(--dr-ui-font) !important;

  letter-spacing: .04em !important;

  margin-bottom: 13px !important;

}

:is(ms-cmark-node,.markdown,.markdown-body) :is(h1,h2,h3) {

  font-family: var(--dr-story-font) !important;

  font-size: 17px !important;

  font-weight: 500 !important;

  color: #806188 !important;

}

:is(ms-cmark-node,.markdown,.markdown-body) strong { font-weight: 500 !important; color: #76597c !important; }

:is(ms-cmark-node,.markdown,.markdown-body) em {

  color: #99849f !important;

  font-weight: 400 !important;

  text-decoration: underline dotted #c7acc7 !important;

  text-underline-offset: 5px !important;

  text-shadow: 0 0 12px #edd3eea8;

}

:is(ms-cmark-node,.markdown,.markdown-body) code:not(pre code),

:is(ms-cmark-node,.markdown,.markdown-body) .inline-code:not(pre *) {

  display: inline !important;

  color: #755c79 !important;

  background: linear-gradient(110deg,#fffdfef5,#f6e9f4f5) !important;

  border: 1px solid #d5bfd9 !important;

  border-radius: 8px !important;

  padding: 2px 7px !important;

  font-family: var(--dr-story-font) !important;

  font-size: .98em !important;

  font-weight: 400 !important;

  line-height: 2 !important;

  white-space: pre-wrap !important;

  overflow-wrap: anywhere !important;

  box-shadow: 0 2px 6px #b28ea61a !important;

  -webkit-box-decoration-break: clone !important;

  box-decoration-break: clone !important;

}

