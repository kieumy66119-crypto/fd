        picker.value = '';

        picker.click();

        return;

      }

      if (e.target.closest('ms-run-button, .run-button')) { playTwinkleSound(); return; }

      if (e.target.closest('button, a, [role="button"], [role="option"], [role="menuitem"], .nav-item, .mdc-list-item, mat-card, tr')) playPopSound();

    }, true);


    // --- 5. BỘ QUÉT TỰ ĐỘNG CHỐNG LAG & TỰ THAY ĐỔI THEO PHÒNG CHAT ---

    const headerEmojiRx = /^\s*(?:📍|⏰|🕰️|⏳|📅|🗓️|🌤️|⛅|🌧️|🌨️|❄️|🌩️|🌙|☀️|🌡️|🕯️|🏛️|🚗|🏥|🏠|🎭|🎬)/u;

    const quoteRx = /["“”][^"“”\n]+["“”]/g;

    let lastSnapshot = '';

    let currentChatKey = '';


    setInterval(() => {

      injectBgChangeButton();


      const chatKey = getChatId();

      if (chatKey !== currentChatKey) {

        currentChatKey = chatKey;

        applySavedAvatars();

      }


      const active = document.activeElement;

      if (active && (active.tagName === 'TEXTAREA' || active.tagName === 'INPUT' || active.isContentEditable)) return;


      document.querySelectorAll(':is(ms-toolbar, ms-playground-toolbar, .page-header, mat-toolbar, ms-navbar, mat-sidenav) button').forEach(btn => {

        if (btn.closest('.chat-turn-container')) return;

        const iconEl = btn.querySelector('mat-icon, .material-symbols-outlined, .material-icons');

        const iconName = (iconEl ? iconEl.textContent : '').trim().toLowerCase();

        const label = ((btn.getAttribute('aria-label') || '') + ' ' + (btn.getAttribute('mattooltip') || '')).toLowerCase();


        if (['menu', 'menu_open', 'left_panel_open', 'left_panel_close', 'dock_to_right', 'view_sidebar'].includes(iconName) || label.includes('navigation')) {

          btn.setAttribute('data-mc-btn', 'nav');

        } else if (iconName === 'edit' || label.includes('edit title') || label.includes('rename')) {

          btn.setAttribute('data-mc-btn', 'edit');

        } else if (iconName === 'share' || iconName === 'ios_share' || label.includes('share')) {

          btn.setAttribute('data-mc-btn', 'share');

        } else if (iconName === 'more_vert' || iconName === 'more_horiz' || label.includes('more')) {

          btn.setAttribute('data-mc-btn', 'more');

        }

      });


      const nodes = document.querySelectorAll('ms-cmark-node');

      const currentSnapshot = nodes.length + ':' + (nodes.length ? nodes[nodes.length - 1].textContent.length : 0);

      if (currentSnapshot === lastSnapshot) return;

      lastSnapshot = currentSnapshot;


      document.querySelectorAll('ms-cmark-node p, ms-cmark-node li').forEach(p => {

        if (headerEmojiRx.test(p.textContent)) p.classList.add('mc-scene-header');

      });


      if (CSS.highlights) {

        const ranges = [];

        nodes.forEach(root => {

          const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);

          let node;

          while ((node = walker.nextNode())) {

            if (node.parentElement && node.parentElement.closest('pre, code, .mc-scene-header')) continue;

            let m;

            while ((m = quoteRx.exec(node.nodeValue)) !== null) {

              const r = new Range();

              r.setStart(node, m.index);

              r.setEnd(node, m.index + m[0].length);

              ranges.push(r);

            }

          }

        });

        CSS.highlights.set('mc-dialogue', new Highlight(...ranges));

      }

    }, 1200);


    window.addEventListener('popstate', applySavedAvatars);

  }


  if (document.readyState === 'loading') {

    document.addEventListener('DOMContentLoaded', initFeatures);

  } else {

    initFeatures();

  }

})();

