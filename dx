/* --- BẬT LẠI FLOATING TITLE & FLOATING BUBBLE THÔNG MINH (SIÊU MƯỢT, 0% LAG) --- */

@keyframes mc-smart-float {

  0%, 100% { transform: translate3d(0, 0px, 0); }

  50%      { transform: translate3d(0, -3.5px, 0); }

}


/* 1. Cho Title truyện, Save prompt, ô Model & System bay lơ lửng */

:is(ms-playground-toolbar h1, ms-toolbar h1, .mat-mdc-dialog-title, .mc-history-title) {

  display: inline-block !important;

  will-change: transform !important;

  animation: mc-smart-float 3.4s ease-in-out infinite !important;

}

:is(mat-card, .model-info-card, .system-instructions-card):not(.mc-cat-frame) {

  will-change: transform !important;

  animation: mc-smart-float 3.8s ease-in-out infinite !important;

}


/* 2. Chỉ cho 4 khung chat mới nhất đang hiện trên màn hình bay bồng bềnh (khung cũ tự nghỉ cho nhẹ máy) */

ms-chat-turn:nth-last-of-type(-n+4) .chat-turn-container {

  will-change: transform !important;

