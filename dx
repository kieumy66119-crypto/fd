/* ================= BẢN CẬP NHẬT V3.5 (TỐI ƯU ĐIỆN THOẠI SIÊU MƯỢT, AVATAR TRÁI, ĐỒNG BỘ MÀU) ================= */


:root {

  /* 1. HÌNH NỀN BẦU TRỜI SAO */

  --mc-star-bg: url("https://i.pinimg.com/1200x/75/e2/5a/75e25a2e4fe019f06eeb611a65ef618d.jpg");


  /* 2. CỠ CHỮ & FONT */

  --mc-input-size: 16.5px !important;

  --mc-vintage-font: 'Playfair Display', 'Cormorant Garamond', 'Times New Roman', serif !important;

  --mc-history-item-font: 'Quicksand', 'Segoe UI', Arial, sans-serif !important;


  /* 3. AVATAR CỦA USER VÀ CHAR (AI) */

  --mc-user-avatar: url("https://i.pinimg.com/originals/39/69/1d/39691dd44f40530e88229980f904ec23.gif");

  --mc-char-avatar: url("https://i.pinimg.com/736x/b9/da/05/b9da0507243b224333a8575f643aafab.jpg");


  /* 4. 4 LINK GIF RIÊNG BIỆT CHO THANH CÔNG CỤ TRÊN CÙNG */

  --gif-nav-menu:   url("https://i.pinimg.com/originals/65/5e/68/655e68134fb22977fdef7013e7cf0a7d.gif");

  --gif-edit-title: url("https://i.pinimg.com/originals/ad/d4/ea/add4ea4849180a18ddbab7cd6544d30f.gif");

  --gif-share:      url("https://i.pinimg.com/originals/3c/80/15/3c801520277e2d5c363e7a73853d7cbb.gif");

  --gif-more:       url("https://i.pinimg.com/originals/9b/9e/5a/9b9e5a7a6df2b07fa59406ee7ba8039a.gif");

}


/* --- 1. HIỆN HÌNH NỀN SAO & ĐỒNG BỘ MÀU THANH BÊN PHẢI (XÓA NỀN TRẮNG LỆCH TÔNG Ở ẢNH 1) --- */

html, body, ms-app, app-root, .mat-drawer-container, .mat-drawer-content {

  background-color: transparent !important;

  background-image: var(--mc-star-bg) !important;

  background-size: cover !important;

  background-position: center !important;

  background-attachment: fixed !important;

  background-repeat: no-repeat !important;

}


:is(main, section, ms-playground, ms-chunk-editor, .chunk-editor-main, ms-autoscroll-container, ms-chat-session, ms-zero-state, .zero-state-container) {

  background: transparent !important;

  background-color: transparent !important;

}


/* Đồng bộ toàn bộ thanh trượt bên phải (Run settings) về 1 màu Tím Hồng Pastel duy nhất */

:is(mat-sidenav, .mat-drawer, ms-run-settings, ms-prompt-run-settings, .run-settings-panel, .settings-panel, .right-panel) {

  background: linear-gradient(165deg, #faedf7f5, #ede1f7f5) !important;

}

:is(mat-sidenav, .mat-drawer, ms-run-settings, ms-prompt-run-settings, .run-settings-panel, .settings-panel, .right-panel) :is(.mat-drawer-inner-container, .panel-content, .settings-container, div:not(.mat-mdc-text-field-wrapper):not(.mdc-text-field)) {

  background-color: transparent !important;

}


/* --- 2. KHUNG CHAT TRONG TRẺO SIÊU MƯỢT (BỎ BLUR GÂY LAG ĐIỆN THOẠI) --- */

ms-chat-turn {

  overflow: visible !important;

  padding-top: 20px !important;

}


/* Khung của Bot */

:is(.chat-turn-container, .chat-turn-container.model, :where(.turn:not(:has(.chat-turn-container)):not(.chat-turn-container .turn)), .mc-model-turn):not(:has(>.mc-ornament)) {

  background: linear-gradient(135deg, rgba(255, 250, 254, 0.72) 0%, rgba(248, 235, 248, 0.62) 100%) !important;

  background-size: 100% 100% !important;

  background-position: center !important;

  border: 1.5px solid rgba(255, 255, 255, 0.9) !important;

  box-shadow: inset 0 0 14px rgba(255, 255, 255, 0.7), 0 6px 18px rgba(145, 95, 138, 0.12) !important;

  overflow: visible !important;

  padding-top: 26px !important;

  margin-top: 38px !important;

}


/* Khung của User: Màu Hồng Pastel ngọt ngào */

:is(.chat-turn-container.user, .turn.input, .mc-user-turn):not(:has(>.mc-ornament)) {

  background: linear-gradient(135deg, rgba(255, 224, 240, 0.85) 0%, rgba(243, 226, 255, 0.8) 55%, rgba(255, 232, 245, 0.86) 100%) !important;

  background-size: 100% 100% !important;

  background-position: center !important;

