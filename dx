  overflow: visible !important;

  padding-top: 26px !important;

  margin-top: 38px !important;

}


/* KHI BẤM NÚT EDIT (SỬA TIN NHẮN): Đổi ô nhập chữ sang màu Hồng Tím Pastel đồng bộ (không bị trắng bóc) */

