  letter-spacing: .03px !important;

  color: #615467 !important;

  background: #fffaffbd !important;

  border-radius: 16px !important;

}

:is(.prompt-box-container,.mc-composer) [contenteditable="true"] * {

  font-family: var(--dr-ui-font) !important;

  font-size: var(--mc-input-size) !important;

  font-weight: 400 !important;

}

:is(.prompt-box-container,.mc-composer) :is(button,[role="button"]) {

  border-radius: 50% !important;

  background: #fffbfee8 !important;

  box-shadow: 0 3px 9px #8f739516 !important;

  border: 1px solid #e0d0e6 !important;

  font: 400 12px / 1.4 var(--dr-ui-font) !important;

}

:is(ms-run-button,.run-button) button,button.run-button,

.mc-composer button.mc-run-button {

  color: #66506c !important;

  background: linear-gradient(120deg,#ebd5e6,#d8c6e5) !important;

